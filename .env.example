# Default target: k3d + Flux cluster (s12, Traefik on port 8888)
VITE_GATEWAY_URL=http://shop.localtest.me:8888
VITE_OIDC_AUTHORITY=http://keycloak.localtest.me:8888/realms/ecommerce
VITE_OIDC_CLIENT_ID=shop

# Observability links (Protocol Inspector & Admin Operations)
VITE_JAEGER_URL=http://jaeger.localtest.me:8888
VITE_GRAFANA_URL=http://grafana.localtest.me:8888
VITE_PROMETHEUS_URL=http://prometheus.localtest.me:8888
VITE_ALERTMANAGER_URL=http://alertmanager.localtest.me:8888
VITE_MAILPIT_URL=http://mail.localtest.me:8888

# For Docker Compose (s11) instead of k3d, run `npm run dev:compose` or use:
# VITE_GATEWAY_URL=http://localhost:8080
# VITE_OIDC_AUTHORITY=http://localhost:8180/realms/ecommerce
# VITE_JAEGER_URL=http://localhost:16686
# VITE_GRAFANA_URL=http://localhost:3000
# VITE_PROMETHEUS_URL=http://localhost:9090
# VITE_ALERTMANAGER_URL=
# VITE_MAILPIT_URL=
